// Tiny synthetic org for the spike (all data invented).
MERGE (asha:Person {id:'p-asha', name:'Asha Rao'})
MERGE (ben:Person {id:'p-ben', name:'Ben Okafor'})
MERGE (pay:Team {id:'t-payments', name:'Payments'})
MERGE (billing:System {id:'s-billing', name:'billing-service'})
MERGE (kafka:System {id:'s-kafka', name:'event-bus'})
MERGE (adr:Doc {id:'d-adr-7', title:'ADR-7: Move billing events to Kafka', url:'https://example.org/adr/7'})
MERGE (dec:Decision {id:'dec-7', title:'Use Kafka for billing events', at:'2026-09-02'})
MERGE (asha)-[:MEMBER_OF]->(pay)
MERGE (ben)-[:MEMBER_OF]->(pay)
MERGE (pay)-[:OWNS]->(billing)
MERGE (billing)-[:DEPENDS_ON {weight:1}]->(kafka)
MERGE (asha)-[:AUTHORED]->(adr)
MERGE (dec)-[:DECIDED_IN]->(adr)
MERGE (dec)-[:MADE_BY]->(asha)
MERGE (dec)-[:AFFECTS]->(billing)
